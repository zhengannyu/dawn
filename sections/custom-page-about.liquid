{%- style -%}
  .about-description-block {
    display: flex;
    flex-flow: row;
    align-items: start;
    margin: 120px 0;
    @media screen and (max-width: 740px) {
      flex-flow: column;
    }
  }
  .about-list-title {
    width: 30%;
    @media screen and (max-width: 740px) {
      width: 100%;
    }
  }
  .about-list-title::before {
    display: inline-block;
    content: '';
    margin-right: 12px;
    width: 12px;
    height: 12px;
    border-radius: 50px;
    background-color: #cdde00;
  }
  .description {
    max-width: 700px;
    h3 {
      font-size: 28px;
      font-weight: 600;
      letter-space: 5px;
      margin: 12px 0;
    }
    p {
      text-align: justify;
    }
  }
  .horizontal-scroll-section {
    width: 100vw;
    height: auto;
    position: sticky;
    overflow: hidden;
  }

  .horizontal-scroll-wrapper {
    display: flex;
    width: max-content;
    height: auto;
    position: sticky;
    top: 0;
    left: 0;
    z-index: 1;
    will-change: transform;
    pointer-events: none;
  }

  .scroll-image {
    flex: 0 0 auto;
    width: 500px;
    margin-right: 24px;
  }

  .scroll-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{%- endstyle -%}

{% assign photos = shop.metaobjects.slider_about.values %}

<div class="horizontal-scroll-section">
  <div class="horizontal-scroll-wrapper" id="horizontal-scroll">
    {% for photo in photos %}
      <div class="scroll-image">
        <img
          srcset="{{ photo.photo | image_url: width: 800 }}"
          alt="about photo"
          width="auto"
          height="100%"
        >
      </div>
    {% endfor %}
  </div>
</div>
{% comment %}
  <div class="sliderimg-wrapper">
    {% for photo in photos %}
      <img
        class="slide"
        srcset="{{ photo.photo | image_url: width: 800 }}"
        sizes="(min-width: 400px) 298px, 40vw"
        alt=""
        width="auto"
        height="100%"
      >
    {% endfor %}
  </div>
{% endcomment %}
