{%- style -%}{%- endstyle -%}
{% comment %} {% assign service_handle_url = request.path | split: "/" | last %} {% endcomment %}
{% assign services = shop.metaobjects.services.values %}
{% assign photos = shop.metaobjects.slider_service.values %}
<div class="custom-index-services">
  {% for service in services %}
    {% if service.system.handle == 'bulk-purchase' %}
      <div class="page-width">
        {% render 'page-title', herotitle: service.herotitle %}
      </div>
      <div class="sliderimg-wrapper">
        {% for picture in photos %}
          <img
            class="slide"
            srcset="{{ picture.photo | image_url: width: 600 }}"
            sizes="(min-width: 400px) 298px, 40vw"
            alt=""
            width="auto"
            height="100%"
          >
        {% endfor %}
      </div>
      <div class="page-width">
        <div class="service-title-block">
          <h1 class="title display-1">{{ service.title }}</h1>
          <p class="line-h250 text-justify">{{ service.description }}</p>
        </div>
      </div>
      <div class="full-bg">
        <div class="page-width">
          <h1 class="display-1">服務流程</h1>
          <p class="process-desp">You got a great product idea, what's next?</p>
          <div class="flex-md-row">
            <div class="w-md-50 process-left">
              <div class="process-card">
                <h5 class="number">01</h5>
                {{ images['idea.svg'] | image_url: width: 60 | image_tag }}
                <div class="textarea">
                  <h4>洽詢</h4>
                  <p>我們傾聽您的需求，並深入了解您的專案目標，確保提供最佳解決方案。</p>
                </div>
              </div>
              <div class="process-card">
                <h5 class="number">02</h5>
                {{ images['message.svg'] | image_url: width: 60 | image_tag }}
                <div class="textarea">
                  <h4>討論</h4>
                  <p>與您密切溝通，共同討論合作細節，為您的專案量身打造最適合的策略。</p>
                </div>
              </div>
            </div>
            <div class="w-md-50 process-right">
              <div class="process-card">
                <h5 class="number">03</h5>
                {{ images['agreement.svg'] | image_url: width: 60 | image_tag }}
                <div class="textarea">
                  <h4>產品報價</h4>
                  <p>根據確認的樣品與您的需求，提供產品報價，同時討論配送方式與付款選項。</p>
                </div>
              </div>
              <div class="process-card last">
                <h5 class="number">04</h5>
                {{ images['production.svg'] | image_url: width: 60 | image_tag }}
                <div class="textarea">
                  <h4>製造與交付</h4>
                  <p>開始生產並嚴格控管品質，準時交付符合您期望的商品。</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    {% endif %}
  {% endfor %}
</div>
